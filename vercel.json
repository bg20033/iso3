{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "functions": {
    "api/contact.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/produkte",
      "destination": "/loesungen",
      "permanent": true
    },
    {
      "source": "/sonderbau",
      "destination": "/produkte/sonderbau",
      "permanent": true
    },
    {
      "source": "/loesungen/ventile-armaturen",
      "destination": "/produkte/ventile",
      "permanent": true
    },
    {
      "source": "/loesungen/:slug",
      "destination": "/produkte/:slug",
      "permanent": true
    }
  ]
}
